# Consumed by docker-compose.yml only (Postgres/Redis container settings).
# App-level Laravel config lives in apps/api/.env — see apps/api/.env.example.
#
# Copy to .env, then run `infra/scripts/tune.sh` to fill in the
# resource-dependent values below from this machine's actual RAM/CPU
# (Tech Spec §4.1) instead of guessing them by hand.

# Dev-only default credentials — must match apps/api/.env DB_USERNAME/DB_PASSWORD.
# Real environments get these from a secret manager (Tech Spec §16), never from
# a file committed to the repo.
POSTGRES_DB=tokospace
POSTGRES_USER=tokospace
POSTGRES_PASSWORD=tokospace

# Environment-driven resource tuning (Tech Spec §4.1/§5) — written by
# infra/scripts/tune.sh, do not hand-edit these to "fix" a specific host.
POSTGRES_SHARED_BUFFERS=256MB
PHP_FPM_MAX_CHILDREN=4
REDIS_MAXMEMORY=256mb
HORIZON_MAX_PROCESSES=2
