APP_NAME=Tokospace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker Compose service name, not localhost — see infra/docker-compose.yml (Tech Spec §5)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tokospace
DB_USERNAME=tokospace
# Dev-only default — must match root .env.example POSTGRES_PASSWORD. Real
# environments get this from a secret manager (Tech Spec §16).
DB_PASSWORD=tokospace

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# 'r2' is the default disk (config/filesystems.php) — no need to set this unless
# temporarily forcing 'local' for debugging.
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@tokospace.com"
MAIL_FROM_NAME="${APP_NAME}"

# Resend (Tech Spec §1) — set once Fase 0 email verification/reset needs it.
RESEND_KEY=

# Cloudflare R2 (S3-compatible) — production media disk (Tech Spec §1.1).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=tokospace
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true

# Environment-driven resource tuning (Tech Spec §5) — computed by
# infra/scripts/tune.sh from detected host RAM/CPU, not hardcoded.
POSTGRES_SHARED_BUFFERS=256MB
PHP_FPM_MAX_CHILDREN=10
REDIS_MAXMEMORY=256mb
HORIZON_MAX_PROCESSES=4

VITE_APP_NAME="${APP_NAME}"
