[www]
user = www-data
group = www-data
listen = 9000
listen.owner = www-data
listen.group = www-data

pm = dynamic
; Tech Spec §4.1/§5 — computed by infra/scripts/tune.sh, never hardcoded.
pm.max_children = ${PHP_FPM_MAX_CHILDREN}
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = ${PHP_FPM_MAX_CHILDREN}

clear_env = no
